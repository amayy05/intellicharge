# IntelliCharge Environment Configuration
# Copy this file to .env and fill in values. NEVER commit .env to version control.

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development  # Set to "production" to enable security startup checks

# ── Security ─────────────────────────────────────────────────────────────────
# REQUIRED: Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_A_STRONG_RANDOM_SECRET_KEY

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slash)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── LLM Configuration (optional) ─────────────────────────────────────────────
# Options: openai / anthropic / gemini / mock
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# ── Google Maps API (optional) ────────────────────────────────────────────────
# Used for real Distance Matrix and live traffic transit times
GOOGLE_MAPS_API_KEY=
