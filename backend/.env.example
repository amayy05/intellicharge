# IntelliCharge Environment Configuration Example

# Google Maps API Key (Optional: for real Distance Matrix and live traffic transit times)
GOOGLE_MAPS_API_KEY=

# JWT Secret Key
SECRET_KEY=intellicharge-secret-key-super-secure-token-2025

# LLM Configuration (Optional: openai / anthropic / gemini / mock)
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
